NODE_ENV=development
PORT=3001

# PostgreSQL server connection. Use a dedicated schema configured by the migration.
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SSL=false

# MinIO/S3-compatible server connection. Use a dedicated bucket for this workbench.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=picagent-suite-workbench
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_LEGACY_BUCKET=rag-assets

# Image generation provider. Secrets stay server-side.
IMAGE_GENERATION_BASE_URL=https://img.yunfei.best
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_GENERATION_TIMEOUT_MS=600000

# DashScope/OpenAI-compatible multimodal model for structured plan generation.
# The plan request sends current base images (or original images) as image_url data URLs.
CONTEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/
CONTEXT_API_KEY=
CONTEXT_MODEL=
CONTEXT_TIMEOUT_MS=600000

# Langfuse + OpenTelemetry observability. Keep secret keys server-side.
OBSERVABILITY_ENABLED=true
OBSERVABILITY_CAPTURE_CONTENT=true
LANGFUSE_BASE_URL=http://127.0.0.1:3002
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_HOST=0.0.0.0
OBSERVABILITY_METRICS_PORT=9464
